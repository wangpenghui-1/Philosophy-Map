{
  "name": "atlas-of-ideas",
  "version": "0.7.3",
  "private": true,
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "content:build": "node scripts/build-knowledge-base.mjs",
    "content:audit": "node scripts/build-knowledge-base.mjs",
    "content:edit": "node scripts/automated-editor.mjs --write",
    "content:edit:check": "node scripts/automated-editor.mjs",
    "content:enrich-sources": "node scripts/enrich-source-metadata.mjs",
    "content:release:prepare": "node scripts/prepare-210-release.mjs --write",
    "content:release:check": "node scripts/check-212-release.mjs",
    "content:release:legacy-check": "node scripts/prepare-210-release.mjs",
    "content:media:prepare": "node scripts/prepare-210-media.mjs --fetch",
    "content:media:prepare:primary": "node scripts/prepare-210-media.mjs --fetch --primary-only",
    "content:media:refresh": "node scripts/prepare-210-media.mjs --fetch --refresh",
    "content:media:refresh:primary": "node scripts/prepare-210-media.mjs --fetch --refresh --primary-only",
    "content:media:check": "node scripts/check-212-media.mjs",
    "media:globe:optimize": "node scripts/optimize-globe-textures.mjs --write",
    "media:globe:check": "node scripts/optimize-globe-textures.mjs",
    "content:media:legacy-check": "node scripts/prepare-210-media.mjs",
    "content:batch:prepare": "node scripts/prepare-content-batch.mjs --all --write",
    "content:batch:check": "node scripts/prepare-content-batch.mjs --all",
    "content:batch:queue": "node scripts/content-batch-runner.mjs --batch 1 --limit 60",
    "content:batch:apply": "node scripts/content-batch-runner.mjs --batch 1 --apply",
    "content:batch:retry": "node scripts/content-batch-runner.mjs --batch 1 --retry",
    "content:batch:report": "node scripts/content-batch-runner.mjs --batch 1 --limit 0",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate:check": "drizzle-kit check",
    "db:studio": "drizzle-kit studio",
    "db:shadow:check": "node --experimental-strip-types scripts/import-knowledge-shadow.mjs",
    "db:shadow:apply": "node --experimental-strip-types scripts/import-knowledge-shadow.mjs --apply",
    "admin:bootstrap": "node --experimental-strip-types scripts/bootstrap-admin.mjs",
    "backend:shadow-check": "node --experimental-strip-types --test tests/backend-shadow.test.mjs tests/editorial-lifecycle.test.mjs tests/member-account.test.mjs tests/memory-privacy.test.mjs",
    "ai:eval": "node --experimental-strip-types scripts/run-ai-evals.mjs",
    "release:manifest": "node scripts/generate-release-manifest.mjs --write",
    "backup:verify": "node scripts/verify-backup.mjs --policy-only",
    "backup:verify:archive": "node scripts/verify-backup.mjs --archive",
    "restore:drill": "node scripts/restore-drill.mjs --dry-run",
    "restore:drill:execute": "node scripts/restore-drill.mjs --execute",
    "deployment:check:plan": "node scripts/check-production-deployment.mjs --dry-run",
    "deployment:report": "node scripts/check-production-deployment.mjs --report-only",
    "deployment:check": "node scripts/check-production-deployment.mjs",
    "security:audit": "npm audit --omit=dev --audit-level=moderate",
    "worker:run-once": "node --experimental-strip-types apps/worker/src/run-once.ts",
    "predev": "npm run content:build",
    "dev": "next dev --webpack",
    "prebuild": "npm run content:build && npm run media:globe:check",
    "build": "next build --webpack",
    "start": "next start",
    "test": "npm run build && node --experimental-strip-types --test tests/rendered-html.test.mjs tests/western-core-quotes.test.mjs tests/bundle-budget.test.mjs tests/globe-marker-layout.test.mjs tests/atlas-visual-policy.test.mjs tests/question-presentations.test.mjs tests/journeys.test.mjs tests/content-production.test.mjs tests/review-pipeline.test.mjs tests/backend-shadow.test.mjs tests/editorial-lifecycle.test.mjs tests/member-account.test.mjs tests/ai-grounding.test.mjs tests/memory-privacy.test.mjs tests/production-security.test.mjs tests/operations-readiness.test.mjs tests/production-deployment.test.mjs",
    "test:e2e": "NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test",
    "test:e2e:update": "NO_PROXY=localhost,127.0.0.1 no_proxy=localhost,127.0.0.1 playwright test --update-snapshots",
    "test:all": "npm run lint && npm test && npm run test:e2e",
    "prelint": "npm run content:build",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "pretypecheck": "npm run content:build",
    "typecheck": "tsc --noEmit",
    "review:automated": "node scripts/run-automated-review.mjs",
    "review:fix": "node scripts/run-automated-review.mjs --fix",
    "review:full": "node scripts/run-automated-review.mjs --full"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1124.0",
    "@aws-sdk/s3-request-presigner": "^3.1124.0",
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "@react-three/postprocessing": "^3.1.1",
    "@sentry/nextjs": "^10.73.0",
    "@vercel/otel": "^2.1.3",
    "drizzle-orm": "^0.45.2",
    "gsap": "^3.15.0",
    "motion": "^12.42.2",
    "next": "^16.3.4",
    "postgres": "^3.4.9",
    "postprocessing": "^6.39.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.5.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@types/three": "^0.184.0",
    "@types/topojson-client": "^3.1.5",
    "drizzle-kit": "^0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3"
  },
  "overrides": {
    "postcss": "8.5.26"
  },
  "type": "module"
}

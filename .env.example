# Optional during the static-compatibility phase. Required for shadow import,
# authenticated user data, persistent conversations, and long-term memory.
DATABASE_URL=
# Least-privilege runtime connection. When set, the application uses this instead of DATABASE_URL.
DATABASE_APP_URL=

# AI answers remain unavailable when no provider key is configured. The public
# knowledge APIs and existing site continue to work without it.
OPENAI_API_KEY=
OPENAI_RESPONSE_MODEL=
OPENAI_EMBEDDING_MODEL=
DEEPSEEK_API_KEY=
DEEPSEEK_RESPONSE_MODEL=
OPENAI_MAX_OUTPUT_TOKENS=1200
OPENAI_TIMEOUT_MS=45000
# Set these to the selected model's published USD price per one million tokens.
OPENAI_INPUT_USD_PER_MILLION=0
OPENAI_OUTPUT_USD_PER_MILLION=0
DEEPSEEK_INPUT_USD_PER_MILLION=0
DEEPSEEK_OUTPUT_USD_PER_MILLION=0

# Used to sign anonymous session identifiers and future Auth.js sessions.
AUTH_SECRET=
APP_BASE_URL=http://127.0.0.1:3010
APP_ENV=development
NEXT_PUBLIC_APP_ENV=development
RESEND_API_KEY=
EMAIL_FROM=

# Only used by the one-time `npm run admin:bootstrap` command. Prefer setting
# these for that single shell invocation instead of saving them in .env files.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_BOOTSTRAP_FORCE=0

# Optional cache and workflow adapters.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# S3-compatible media storage. Existing /public media remains the fallback.
MEDIA_UPLOADS_ENABLED=0
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=
S3_FORCE_PATH_STYLE=0

# Required before uploaded media can leave quarantine. The scanner receives
# only the configured bucket and object key, never application credentials.
MEDIA_SCAN_ENDPOINT=
MEDIA_SCAN_TOKEN=

# Error reporting and distributed tracing. Browser and server DSNs normally
# point at the same Sentry project; auth token is build-only for source maps.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# When enabled, readiness fails unless all production-critical services are
# configured and reachable. Keep off for static compatibility and local work.
REQUIRE_PRODUCTION_SERVICES=0
NEXT_PUBLIC_MEDIA_ORIGIN=
